# Default experiment output directories at repository root.
# Examples use paths relative to the current working directory.
# Keep all experiment artifacts in these directories.
/runs/
/outputs/
/output/
/results/
/checkpoints/
/logs/
/wandb/
/lightning_logs/

# Example outputs at any depth, including when run from a subdirectory.
/examples/**/runs/
/examples/**/outputs/
/examples/**/output/
/examples/**/results/
/examples/**/checkpoints/
/examples/**/logs/
/examples/**/eval/
/examples/**/demo_data/
/examples/**/data/
/examples/**/wandb/
/examples/**/lightning_logs/

# Common result files generated outside the default output folders.
# Preserve Python scripts, notebooks, Markdown and configuration files.
/examples/**/*.csv
/examples/**/*.tsv
/examples/**/*.npy
/examples/**/*.npz
/examples/**/*.mat
/examples/**/*.parquet
